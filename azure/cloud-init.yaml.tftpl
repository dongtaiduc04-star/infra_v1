#cloud-config
package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl

ssh_pwauth: false
disable_root: true

write_files:
  - path: /etc/sysctl.d/99-k3s.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.ip_forward=1

  - path: /etc/rancher/k3s/config.yaml
    owner: root:root
    permissions: "0600"
    content: |
      write-kubeconfig-mode: "0600"
      secrets-encryption: true
      node-name: "getlink-k3s"

runcmd:
  - [sysctl, --system]
  - [sh, -c, "curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION='${k3s_version}' sh -s - server"]

final_message: "k3s bootstrap completed"
