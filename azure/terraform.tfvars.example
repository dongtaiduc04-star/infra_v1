# Copy to terraform.tfvars only when you need to override a safe default.
# terraform.tfvars is ignored and must never contain private keys or tokens.

location            = "malaysiawest"
vm_size             = "Standard_B2as_v2"
sonarqube_vm_size   = "Standard_B2as_v2"
ssh_public_key_path = "~/.ssh/azure_k3s_ed25519.pub"

# These safe, non-secret defaults are shown for clarity. The Cloudflare Tunnel
# token and SonarQube analysis token must never be placed in tfvars.
sonarqube_private_ip_address = "10.60.1.20"
sonarqube_hostname           = "sonar.example.com"
sonarqube_image              = "sonarqube:26.9.0.129388-community"
sonarqube_postgres_image     = "postgres:18.6-bookworm"
sonarqube_cloudflared_image  = "cloudflare/cloudflared:2026.9.3"
